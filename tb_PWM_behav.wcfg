<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_PWM_behav.wdb" id="1">
         <top_modules>
            <top_module name="tb_PWM" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000 us"></ZoomStartTime>
      <ZoomEndTime time="22.000001 us"></ZoomEndTime>
      <Cursor1Time time="15.700000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="340"></NameColumnWidth>
      <ValueColumnWidth column_width="150"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="/tb_PWM/sig_sig" type="array">
      <obj_property name="ElementShortName">sig_sig[7:0]</obj_property>
      <obj_property name="ObjectShortName">sig_sig[7:0]</obj_property>
      <obj_property name="CustomSignalColor">#FF0000</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_PWM/car_sig" type="array">
      <obj_property name="ElementShortName">car_sig[7:0]</obj_property>
      <obj_property name="ObjectShortName">car_sig[7:0]</obj_property>
      <obj_property name="WaveformStyle">STYLE_ANALOG</obj_property>
      <obj_property name="CellHeight">100</obj_property>
      <obj_property name="CustomSignalColor">#FF00FF</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_PWM/Clk_tb" type="logic">
      <obj_property name="ElementShortName">Clk_tb</obj_property>
      <obj_property name="ObjectShortName">Clk_tb</obj_property>
      <obj_property name="CustomSignalColor">#FFFF00</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_PWM/pwm_out_tb" type="logic">
      <obj_property name="ElementShortName">pwm_out_tb</obj_property>
      <obj_property name="ObjectShortName">pwm_out_tb</obj_property>
      <obj_property name="CustomSignalColor">#00FFFF</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_PWM/clock_period" type="other">
      <obj_property name="ElementShortName">clock_period</obj_property>
      <obj_property name="ObjectShortName">clock_period</obj_property>
   </wvobject>
</wave_config>
